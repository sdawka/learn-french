{
  "name": "french-learning",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "seed": "bun src/content/vocabulary/seed.ts",
    "migrate:export": "bun scripts/export-data.ts",
    "deploy": "astro build && wrangler deploy",
    "d1:schema": "bunx wrangler d1 execute french-learning --file=./migrations/schema.sql",
    "d1:import": "bunx wrangler d1 execute french-learning --file=./migrations/data.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "astro": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "@types/bun": "^1.3.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "typescript": "^5.6.0",
    "wrangler": "^4.154.0"
  }
}
