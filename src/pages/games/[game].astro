---
/**
 * Game shell page — /games/vocabulary, /games/grammar
 * Reads ?mood= from query params and mounts the GameOrchestrator island.
 */

import GameOrchestrator from "~/components/games/GameOrchestrator.tsx";

const { game } = Astro.params;
const mood = Astro.url.searchParams.get("mood") ?? "review";

const validSubjects = ["vocabulary", "grammar", "mixed"];
const subject = validSubjects.includes(game ?? "") ? game! : "mixed";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{subject.charAt(0).toUpperCase() + subject.slice(1)} — French</title>
</head>
<body class="bg-gray-950 text-white">
  <GameOrchestrator client:load subject={subject} mood={mood} />
</body>
</html>
